node_modules
dist
dist-ssr
*.local

# 环境变量（含密钥，别提交）
# 例外：*.example 模板不含真值，要跟着仓库走，否则同事拿不到配置说明
.env
.env.*
!.env.example
!.env.*.example

# 冒烟测试截图产物
.smoke

# UI 截图产物（scripts/ui-shot.mjs）
.uishot

# 本地数据库文件（已切 MySQL，保留以防旧文件残留）
server/data.db
server/*.db

# Python 虚拟环境（ai-server 是练手实验分支，venv 不进版本库）
venv
.venv
__pycache__
*.pyc

# RAG 索引缓存（启动时自动重建，不进版本库）
server/rag_index.json

# 运行时上传产物（用户服装图片，含隐私，任何人都不要提交）
server/uploads/

# 会话交接文档（含环境细节与未决讨论）
# 默认忽略，避免 git add -A 把草稿一起扫进来；
# 要归档的用 git add -f 强制入库。⚠️ 本地提交可以，不要 push 到远端。
.handoff/

# 微信小程序：本机私有配置（每个开发者各自生成，共享忽略规则）
project.private.config.json

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 日志
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.DS_Store

# 本地验收脚本与截图（可再生）
.tmp/

# 图片瘦身前的原图备份（14MB，不进仓库；源文件本身有 git 历史可回滚）
.image-backup/

# 体验版打包的真实配置（含云开发环境 ID），按 .env.production.example 自行创建
miniapp/.env.production

# 部署打包产物（含真实 key 的环境变量清单，别提交）
deploy/dist/
