# 前端生产配置：复制为 .env.production，填写自己的环境信息。
# H5 和小程序构建都会读取本文件；不要提交实际环境的配置。

# 当前项目的小程序通过已有 api 云函数访问微信云托管。
# 填入你自己的云开发环境 ID，并在云函数中配置 API_ORIGIN 指向后端。
# 若使用可加入微信 request 白名单的自有域名直连后端，可留空。
VITE_CLOUD_ENV=your-cloud-env-id

# H5 API 地址；小程序启用云函数转发后使用云函数。
VITE_API_BASE_URL=https://your-api-domain.example.com

# 云托管中的公开演示图片目录；小程序打包时将静态图移出主包。
VITE_CLOUD_IMG_BASE=https://your-api-domain.example.com/images

# 可选：默认关闭性能采集，开启后按会话采样。
VITE_PERF_ENABLED=false
VITE_PERF_SAMPLE_RATE=0.1
VITE_APP_RELEASE=local
