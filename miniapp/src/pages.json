      "pages": [
        { "path": "cart/index", "style": { "navigationStyle": "custom" } },
        { "path": "checkout/index", "style": { "navigationStyle": "custom" } },
        { "path": "orders/index", "style": { "navigationStyle": "custom" } },
        { "path": "order-detail/index", "style": { "navigationStyle": "custom" } }
      ]
    },
    {
      "root": "pages-sub/custom",
      "name": "custom",
      "pages": [
        { "path": "custom/index", "style": { "navigationStyle": "custom" } },
        { "path": "custom/category", "style": { "navigationStyle": "custom" } },
        { "path": "custom/orders", "style": { "navigationStyle": "custom" } },
        { "path": "custom/order", "style": { "navigationStyle": "custom" } }
