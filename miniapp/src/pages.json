  "preloadRule": {
    "pages/home/home": { "network": "all", "packages": ["content", "wardrobe"] },
    "pages/closet/closet": { "network": "all", "packages": ["wardrobe", "profile"] },
    "pages/mall/mall": { "network": "all", "packages": ["trade", "content"] },
    "pages/me/me": { "network": "all", "packages": ["profile", "content", "trade"] },
    "pages/ai/ai": { "network": "all", "packages": ["profile", "wardrobe"] }
  },
  "tabBar": {
    "color": "#6d6e70",
    "selectedColor": "#b84271",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      { "pagePath": "pages/home/home", "text": "首页" },
      { "pagePath": "pages/ai/ai", "text": "Ai" },
      { "pagePath": "pages/closet/closet", "text": "衣橱" },
