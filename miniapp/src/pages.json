{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^(CreateBasicInfo|CreateToolRail)$": "@/pages-sub/profile/create/$1.vue",
      "^MallDetailSheet$": "@/pages/mall/MallDetailSheet.vue",
      "^SceneWeather$": "@/pages-sub/wardrobe/scene/SceneWeather.vue",
      "^(StyleStep|SkinStep|FaceStep|BodyStep|PrefStep)$": "@/pages-sub/profile/test/$1.vue",
      /*
       * 图表组件刻意放在 profile 分包里，不留在共享 components/。
       *
       * 它们唯一依赖 echarts，而 echarts 约 428 KB。留在共享目录时，
       * 分包页引用共享组件会让「组件 + echarts」一起被提升回主包公共 vendor，
       * 主包白扛 45% 的体积 —— 分包就白拆了。只有这两个页面用图表，
       * 所以放进它们所在的分包，echarts 才会跟着进分包。
       */
      "^(RadarChart|MetricChart)$": "@/pages-sub/profile/components/$1/$1.vue",
      "^uv-(.*)": "@climblee/uv-ui/components/uv-$1/uv-$1.vue",
      "^(?!z-|transition|scroll-view|view|text|image|button|input)[A-Z](.*)": "@/components/$1/$1.vue"
    }
  },
  "pages": [
    { "path": "pages/home/home", "style": { "navigationStyle": "custom" } },
    { "path": "pages/login/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/ai/ai", "style": { "navigationStyle": "custom" } },
    { "path": "pages/closet/closet", "style": { "navigationStyle": "custom" } },
    { "path": "pages/mall/mall", "style": { "navigationStyle": "custom" } },
    { "path": "pages/me/me", "style": { "navigationStyle": "custom" } }
  ],
  "subPackages": [
    {
      "root": "pages-sub/profile",
      "name": "profile",
      "pages": [
        { "path": "body-create/index", "style": { "navigationStyle": "custom" } },
        { "path": "create/index", "style": { "navigationStyle": "custom" } },
        { "path": "test/index", "style": { "navigationStyle": "custom" } },
        { "path": "result/index", "style": { "navigationStyle": "custom" } },
        { "path": "stylist/index", "style": { "navigationStyle": "custom" } },
        { "path": "admin/index", "style": { "navigationStyle": "custom" } },
        { "path": "verify/index", "style": { "navigationStyle": "custom" } },
        { "path": "profile-edit/index", "style": { "navigationStyle": "custom" } }
      ]
    },
    {
      "root": "pages-sub/wardrobe",
      "name": "wardrobe",
      "pages": [
        { "path": "wardrobe-upload/index", "style": { "navigationStyle": "custom" } },
        { "path": "wardrobe-match/index", "style": { "navigationStyle": "custom" } },
        { "path": "free-match/index", "style": { "navigationStyle": "custom" } },
        { "path": "outfit-result/index", "style": { "navigationStyle": "custom" } },
        { "path": "outfits/index", "style": { "navigationStyle": "custom" } },
        { "path": "scene/index", "style": { "navigationStyle": "custom" } },
        { "path": "accessory/index", "style": { "navigationStyle": "custom" } },
        { "path": "diary/index", "style": { "navigationStyle": "custom" } }
      ]
    },
    {
      "root": "pages-sub/trade",
