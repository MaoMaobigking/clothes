# ===== AI 后端配置 =====
# 填好下面几个值后，运行：npm run server
# 改完 .env 要重启后端才生效。

# 接口格式：openai(兼容大多数国内外服务) 或 anthropic(Claude)
AI_PROVIDER=openai

# 你的 API key（必填）
AI_API_KEY=

# 模型名（按你的服务商填，见下方参考）
AI_MODEL=

# 接口地址（openai 兼容需要填；用 Claude 时可留空）
AI_BASE_URL=

# 可选：填写 OpenWeather API Key 后，场景页会请求真实天气；
# 不填则使用“定位城市 + 可解释的本地降级天气”，不影响生成。
OPENWEATHER_API_KEY=

# 后端端口（一般不用改）
PORT=8787

# -------- 常见服务商参考：把上面 4 个值改成对应这一行 --------
# DeepSeek:  AI_PROVIDER=openai     AI_BASE_URL=https://api.deepseek.com                          AI_MODEL=deepseek-chat
# 通义千问:  AI_PROVIDER=openai     AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  AI_MODEL=qwen-plus
# 智谱GLM:   AI_PROVIDER=openai     AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4              AI_MODEL=glm-4-flash
# Kimi:      AI_PROVIDER=openai     AI_BASE_URL=https://api.moonshot.cn/v1                        AI_MODEL=moonshot-v1-8k
# OpenAI:    AI_PROVIDER=openai     AI_BASE_URL=https://api.openai.com/v1                         AI_MODEL=gpt-4o-mini
# Claude:    AI_PROVIDER=anthropic  AI_MODEL=claude-haiku-4-5-20251001   (AI_BASE_URL 留空)

# ===== 数据库（MySQL，必填） =====
# 本地起容器：
#   docker run -d --name lingxi-mysql -p 3308:3306 \
#     -e MYSQL_ROOT_PASSWORD=你的密码 -e MYSQL_DATABASE=lingxi \
#     --restart unless-stopped mysql:8.0 \
#     --character-set-server=utf8mb4 --collation-server=utf8mb4_unicode_ci
# 建表：cd server && npm run db:init
MYSQL_HOST=localhost
MYSQL_PORT=3308
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=lingxi

# ===== JWT 密钥（必填，缺失或短于 16 位后端拒绝启动） =====
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ===== 微信小程序（可选） =====
# 不填则登录走开发态 mock openid（对 code 取 sha256，同 code 稳定映射同一用户）
WX_APPID=
WX_SECRET=
